{
  "name": "energy-trail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "자국 (Energy Trail) — 3D 술래잡기 게임. 네온 잔상 흡수 메커니즘으로 달리고 쫓는 카툰 파티 게임.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:network-sim": "node scripts/network-sim.mjs"
  },
  "dependencies": {
    "three": "^0.178.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/three": "^0.178.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
